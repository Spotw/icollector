{
  "name": "icollector",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm build && concurrently --kill-others-on-fail \"wrangler dev --port 8787\" \"vite --host 0.0.0.0 --port 5173\"",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "db:init": "wrangler d1 execute db_duyvu --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute db_duyvu --local --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.8.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "vite": "^7.1.5",
    "wrangler": "^4.35.0"
  }
}
