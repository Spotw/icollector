{
  "name": "icollector",
  "main": "public/index.html",
  "compatibility_date": "2026-10-20",
  "observability": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db_duyvu",
      "database_id": "569b0708-7673-4d86-9ec4-8ff448f48f0e"
    }
  ]
}
