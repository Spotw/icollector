{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icollector",
  "main": "src/server/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db_duyvu",
      "database_id": "569b0708-7673-4d86-9ec4-8ff448f48f0e"
    }
  ]
}
